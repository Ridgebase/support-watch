{
  "routes": [
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/.auth/*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/signed-out.html", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/*", "allowedRoles": ["reader"] }
  ],
  "responseOverrides": {
    "401": { "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer", "statusCode": 302 },
    "403": { "rewrite": "/forbidden.html", "statusCode": 403 }
  },
  "navigationFallback": { "rewrite": "/index.html" }
}
